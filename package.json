{
  "name": "openwolf",
  "version": "2.5.2",
  "description": "Local project memory, context tools and recorded token usage for coding agents.",
  "type": "module",
  "bin": {
    "openwolf": "dist/bin/openwolf.js"
  },
  "scripts": {
    "prebuild": "node scripts/sync-plugin-runtime.mjs && node -e \"const fs=require('fs');if(fs.existsSync('dist'))fs.rmSync('dist',{recursive:true})\"",
    "build": "tsc && pnpm check:plugin && pnpm check:dashboard && pnpm build:hooks && pnpm build:dashboard",
    "build:hooks": "tsc -p tsconfig.hooks.json",
    "build:dashboard": "cd src/dashboard/app && npx vite build --outDir ../../../dist/dashboard",
    "dev": "tsc --watch",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "prepublishOnly": "pnpm build",
    "test": "node --test tests/*.test.ts",
    "pretest": "node scripts/sync-plugin-runtime.mjs && tsc && tsc -p tsconfig.hooks.json && pnpm check:plugin && pnpm check:dashboard",
    "check:plugin": "tsc -p tsconfig.plugin.json",
    "check:dashboard": "tsc -p tsconfig.dashboard.json"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "chokidar": "^4.0.3",
    "commander": "^12.1.0",
    "express": "^5.2.1",
    "ignore": "^7.0.9",
    "node-cron": "^4.6.0",
    "open": "^10.2.0",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.24.7",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.30",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^2.15.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitepress": "^1.6.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "AGPL-3.0-only",
  "author": "Cytostack Pvt Ltd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cytostack/openwolf.git"
  },
  "homepage": "https://github.com/cytostack/openwolf",
  "bugs": {
    "url": "https://github.com/cytostack/openwolf/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "opencode",
    "agent-memory",
    "context-engineering",
    "observability",
    "context",
    "token",
    "openwolf",
    "developer-tools",
    "ai"
  ],
  "files": [
    "dist/",
    "src/templates/",
    "LICENSE",
    "README.md",
    "CREDITS.md",
    "docs/audit/README.md",
    "docs/audit/contributions.json",
    "docs/audit/pr-commits.json",
    "docs/repair-operations.md",
    "docs/claude-codex-handoff-plan.md",
    "docs/automatic-updates.md",
    "docs/session-visibility-plan.md",
    "CHANGELOG.md",
    "docs/release-2.5.2.md"
  ],
  "pnpm": {
    "overrides": {
      "qs": "6.16.0",
      "body-parser": "2.3.0"
    }
  },
  "openwolfRuntime": {
    "protocol": 1
  }
}
